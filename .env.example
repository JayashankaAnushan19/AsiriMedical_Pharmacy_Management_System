# Copy this file to .env and fill in your values.
# On Docker / hosting panels you can set these as real environment variables instead.

# true shows PHP errors in the page (local only). Always false on a live server.
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_pms
DB_USER=root
DB_PASS=

# Only for shared hosting without SSH: set a long random value, open
#   https://your-site/model/migrate.php?token=<value>
# once after uploading, then clear it again.
MIGRATE_TOKEN=
